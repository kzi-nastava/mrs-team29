<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/item_driver_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Driver" />

        <TextView
            android:id="@+id/item_ride_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ride ID" />

        <TextView
            android:id="@+id/item_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status" />

        <TextView
            android:id="@+id/item_pickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup" />

        <TextView
            android:id="@+id/item_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination" />

        <TextView
            android:id="@+id/item_started"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Started" />

        <TextView
            android:id="@+id/item_est_arrival"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimated arrival" />

        <TextView
            android:id="@+id/item_current_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current position" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
