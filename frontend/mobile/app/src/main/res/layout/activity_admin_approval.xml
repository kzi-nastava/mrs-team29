<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/admin_approval_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/admin_approval_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Profile Approvals"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/admin_approval_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review and approve or reject driver profile changes"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/admin_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading requests..."
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/admin_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending profile change requests"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/admin_request_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
