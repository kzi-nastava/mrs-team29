<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/passenger_ride_tracking_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/ride_tracking_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track your ride"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/ride_tracking_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Loading..."
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/ride_tracking_pickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup: Loading..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ride_tracking_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination: Loading..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ride_tracking_eta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ETA: Calculating..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ride_tracking_report_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report driver inconsistency"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ride_tracking_refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
